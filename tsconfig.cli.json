{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-cli",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/cli/**/*.ts",
    "src/main/modules/config/**/*.ts",
    "src/main/modules/gitlab/**/*.ts",
    "src/shared/types/**/*.ts",
    "src/utils/**/*.ts",
    "src/utils/**/*.json"
  ]
}
